   "source": "# DOE MASTER FULL PIPELINE — integrated Anaconda notebook\n\nThis is the final Git-free DOE desktop notebook. It integrates the three-workbook ML runtime logic into one Jupyter file: header scan, validation, feature/proxy engineering, leakage-safe target handling, main train/predict runs, dataset-3 training mode, and all-saturation target runs.\n\nInputs are the three normalized Excel workbooks for the four wells. Real measured NMR is not required; NMR-style evidence is represented through proxy features from the available well-log parameters. Optional moisture/temperature CSV context is loaded only if found locally."
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": "from pathlib import Path\nfrom datetime import datetime, timezone\nimport json, re, warnings\n\nrequired = ['pandas','numpy','sklearn','openpyxl','joblib']\nmissing=[]\nfor p in required:\n    try: __import__(p)\n    except Exception: missing.append(p)\nif missing:\n    raise ImportError(f'Missing Anaconda packages: {missing}')\n\nimport numpy as np\nimport pandas as pd\nfrom joblib import dump\nfrom sklearn.ensemble import RandomForestClassifier, RandomForestRegressor\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.metrics import accuracy_score, balanced_accuracy_score, f1_score, mean_absolute_error, mean_squared_error, r2_score\nfrom sklearn.neural_network import MLPClassifier, MLPRegressor\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import MinMaxScaler\n\n# -----------------------------\n# 01 setup / project assumptions\n# -----------------------------\nDATA_DIR = Path.home() / 'Downloads' / 'Northslopedatasets06052026'\nWORKBOOKS = ('curated_dataset1.xlsx','curated_dataset2.xlsx','curated_dataset3.xlsx')\nEXPECTED_WELL_COUNT = 4\nNORMALIZED_INPUTS = True\nUSE_REAL_NMR_IF_PRESENT = False\nMOISTURE_TEMPERATURE_CSV_NAME = None\nDEFAULT_MODEL_KIND = 'baseline'  # baseline or mlp\nUSE_SCALER = False              # inputs already normalized; switch True mainly for MLP experiments\nRANDOM_STATE = 42\nOUTPUT_ROOT = Path.cwd() / 'outputs_runtime'\nMODEL_ROOT = Path.cwd() / 'models_runtime'\nOUTPUT_ROOT.mkdir(parents=True, exist_ok=True); MODEL_ROOT.mkdir(parents=True, exist_ok=True)\n\nprint('Notebook folder:', Path.cwd())\nprint('Data folder:', DATA_DIR)\nfor f in WORKBOOKS:\n    print(f, 'FOUND' if (DATA_DIR/f).exists() else 'MISSING')\n\n# -----------------------------\n# 02 schema / aliases / contracts\n# -----------------------------\nREQUIRED_LOG_COLUMNS = ('well_alias','depth_m','gr_api','rt_ohm_m','rhob_g_cc')\nOPTIONAL_LOG_COLUMNS = ('density_porosity_vv','neutron_porosity_vv','dt_us_ft','dts_us_ft','vp_km_s','vs_km_s','vp_m_s','vs_m_s','nmr_porosity_vv','caliper_in','temperature_c','pressure_mpa')\nCHONG_ML_FEATURE_COLUMNS = ('rhob_g_cc','density_porosity_vv','rt_ohm_m','gr_api','vp_km_s','vs_km_s')\nTARGET_ONLY_COLUMN_ALIASES = {\n 'hydrate_saturation':('Sgh','S_h','Sh','Shyd','NMR_SAT','Hydrate Saturation','hydrate_saturation_vv','hydrate_sat'),\n 'irreducible_or_residual_water_saturation':('Swr','S_wr','Swirr','irreducible_water_saturation_vv'),\n 'phase_or_occurrence_label':('interpreted phase label','phase_label','hydrate_phase','hydrate_occurrence_label','runtime_phase_label','class','label','occurrence')}\nCURVE_ALIASES = {\n 'well_alias':('well_alias','WELL','WELL_NAME','Well Name','UWI','API','Well'),\n 'depth_m':('depth_m','DEPTH_M','DEPTH','MD','MD_M','TVD','TVD_M','DEPT'),\n 'gr_api':('gr_api','GR','GAMMA','GAMMA_RAY','Gamma Ray'),\n 'rt_ohm_m':('rt_ohm_m','RT','ILD','RDEP','RES','RES_DEEP','Deep formation resistivity'),\n 'rhob_g_cc':('rhob_g_cc','RHOB','DEN','DENSITY','Rho_b','Density_gcpcc','Density_gpcc','bulk_density'),\n 'density_porosity_vv':('density_porosity_vv','DPHI','PHID','DEN_POR','Phi_porosity','phi_den','densityporosity'),\n 'neutron_porosity_vv':('neutron_porosity_vv','NPHI','TNPH','NEUTRON_POR','phi_neut'),\n 'dt_us_ft':('dt_us_ft','DT','DTC','AC'), 'dts_us_ft':('dts_us_ft','DTS','DTSM'),\n 'vp_km_s':('vp_km_s','VP_KM_S','vpkms'), 'vs_km_s':('vs_km_s','VS_KM_S','vskms'),\n 'vp_m_s':('vp_m_s','Vp','VP','VELP','VP_M_S','vpmps'), 'vs_m_s':('vs_m_s','Vs','VS','VS1','VELS','VS_M_S','vsmps'),\n 'nmr_porosity_vv':('nmr_porosity_vv','NMRPHI','TCMR','CMRP','phi_nmr','nmrporosity'),\n 'caliper_in':('caliper_in','CALI','CALIPER','caliper','CAL1'),\n 'temperature_c':('temperature_c','TEMP','TEMPERATURE_C','temperature'), 'pressure_mpa':('pressure_mpa','PRESSURE','PRESSURE_MPA','PP_MPA')}\nCLASSIFICATION_NAME_HINTS=('occurrence','class','label','phase','hydratepresent')\nREGRESSION_NAME_HINTS=('saturation','sat','sgh','shyd','nmr_sat')\nCONTEXT_OR_HELPER_EXACT={'index','row','rowindex','depth','depthm','depthft','dept','md','tvd'}\nCONTEXT_OR_HELPER_PARTS=('depth','unit','units')\nIDENTIFIER_AND_CONTEXT_COLUMNS={'well_alias','depth_m','source_dataset','dataset_file','source_sheet','split','row_index','source_workbook','source_sheet_name'}\nMAX_MODEL_ABS_VALUE=1.0e12\nRANGE_CHECKS_PHYSICAL={'depth_m':(0,10000),'gr_api':(0,300),'rt_ohm_m':(0.01,100000),'rhob_g_cc':(1.0,3.2),'density_porosity_vv':(0,0.7),'neutron_porosity_vv':(0,0.7),'dt_us_ft':(30,250),'dts_us_ft':(50,500),'vp_km_s':(1.0,8.0),'vs_km_s':(0.3,5.0),'vp_m_s':(1000,8000),'vs_m_s':(300,5000),'caliper_in':(4,24),'temperature_c':(-30,120),'pressure_mpa':(0,150)}\n\ndef normalize_header_name(x): return ''.join(c for c in str(x).lower() if c.isalnum())\ndef sanitize_label(x, max_len=100): return (re.sub(r'[^A-Za-z0-9_.-]+','_',str(x).strip()).strip('._-')[:max_len] or 'run')\ndef clean_numeric_series(s):\n    v=pd.to_numeric(s, errors='coerce').replace([np.inf,-np.inf], np.nan)\n    return v.mask(v.abs()>MAX_MODEL_ABS_VALUE)\ndef clean_numeric_frame(df):\n    out=df.copy()\n    for c in out.columns:\n        out[c]=clean_numeric_series(out[c].astype(int) if pd.api.types.is_bool_dtype(out[c]) else out[c])\n    return out\ndef target_alias_lookup():\n    d={}\n    for fam, als in TARGET_ONLY_COLUMN_ALIASES.items():\n        for a in als: d[normalize_header_name(a)] = (fam,a)\n    return d\ndef canonical_name_for_header(h):\n    n=normalize_header_name(h)\n    for can, als in CURVE_ALIASES.items():\n        if n==normalize_header_name(can) or any(n==normalize_header_name(a) for a in als): return can\n    return None\ndef target_like_column(c):\n    n=normalize_header_name(c)\n    if n in target_alias_lookup() or n in {'class','label','target','y','occurrence','phase','hydratepresent'}: return True\n    return (('hydrate' in n or 'sgh' in n or n.startswith('sh')) and any(w in n for w in ('sat','saturation','occur','class','label','phase')))\ndef saturation_like_column(c):\n    n=normalize_header_name(c)\n    if any(w in n for w in ('porosity','density','sample','station','status')): return False\n    return n in {'sgh','sh','shyd','hydratesat','hydratesaturation','nmrsat','swr','sw','swi','swirr'} or 'sat' in n or 'saturation' in n\ndef is_context_or_helper_column(c):\n    n=normalize_header_name(c); can=canonical_name_for_header(c)\n    return n.startswith('unnamed') or n in CONTEXT_OR_HELPER_EXACT or any(p in n for p in CONTEXT_OR_HELPER_PARTS) or can in {'well_alias','depth_m'}\n\n# -----------------------------\n# 03 loading / standardization\n# -----------------------------\ndef standardize_curve_columns(frame):\n    lookup={normalize_header_name(c):c for c in frame.columns}; ren={}\n    for can, als in CURVE_ALIASES.items():\n        for a in als:\n            actual=lookup.get(normalize_header_name(a))\n            if actual is not None:\n                ren[actual]=can; break\n    out=frame.rename(columns=ren).copy()\n    for c in out.columns:\n        if c=='well_alias': continue\n        v=clean_numeric_series(out[c])\n        if v.notna().any(): out[c]=v\n    if 'well_alias' in out: out['well_alias']=out['well_alias'].astype(str)\n    return out\ndef read_first_nonempty_excel_sheet(path, sheet_name=None):\n    if not path.exists(): raise FileNotFoundError(path)\n    with pd.ExcelFile(path) as xl: names=list(xl.sheet_names)\n    for s in ([sheet_name] if sheet_name else names):\n        if s not in names: raise ValueError(f'Sheet {s!r} missing from {path.name}')\n        df=pd.read_excel(path, sheet_name=s)\n        if not df.empty and len(df.columns): return df, str(s)\n    return pd.read_excel(path, sheet_name=names[0]), str(names[0])\ndef load_workbook_dataset(data_dir, file_name, split, sheet_name=None):\n    raw, sheet = read_first_nonempty_excel_sheet(Path(data_dir)/file_name, sheet_name)\n    df=standardize_curve_columns(raw)\n    df['source_dataset']=Path(file_name).stem; df['dataset_file']=file_name; df['source_sheet']=sheet; df['split']=split; df['row_index']=np.arange(len(df))\n    if 'well_alias' not in df: df['well_alias']=Path(file_name).stem\n    return {'label':Path(file_name).stem,'split':split,'path':str(Path(data_dir)/file_name),'sheet_name':sheet,'frame':df}\ndef load_three_dataset_workbooks(data_dir=DATA_DIR, train_file='curated_dataset1.xlsx', test_files=('curated_dataset2.xlsx','curated_dataset3.xlsx'), sheet_name=None):\n    ds=[load_workbook_dataset(data_dir, train_file, 'train', sheet_name)]\n    for f in test_files:\n        if (Path(data_dir)/f).exists(): ds.append(load_workbook_dataset(data_dir, f, 'test', sheet_name))\n    return ds\n\n# -----------------------------\n# 04 optional moisture/temp CSV\n# -----------------------------\ndef find_moisture_temperature_csv():\n    candidates=[]\n    roots=[Path.cwd(), DATA_DIR, Path.home()/'Downloads']\n    if MOISTURE_TEMPERATURE_CSV_NAME:\n        for r in roots:\n            p=r/MOISTURE_TEMPERATURE_CSV_NAME\n            if p.exists(): return p\n    for r in roots:\n        if not r.exists(): continue\n        for p in r.glob('*.csv'):\n            n=p.name.lower()\n            if ('moisture' in n or 'water' in n) and ('temperature' in n or 'temp' in n): candidates.append(p)\n    return candidates[0] if candidates else None\ndef load_moisture_temperature_context(output_root=OUTPUT_ROOT):\n    p=find_moisture_temperature_csv(); out=output_root/'moisture_temperature_context'; out.mkdir(parents=True, exist_ok=True)\n    if not p:\n        manifest={'status':'not_found','message':'optional moisture/temperature CSV was not found'}\n        (out/'manifest.json').write_text(json.dumps(manifest,indent=2), encoding='utf-8'); return manifest\n    df=pd.read_csv(p); df.head(50).to_csv(out/'preview_first_50_rows.csv', index=False)\n    inv=pd.DataFrame([{'csv_path':str(p),'rows':len(df),'columns':len(df.columns),'column_names':', '.join(map(str,df.columns))}])\n    inv.to_csv(out/'csv_inventory.csv', index=False)\n    manifest={'status':'loaded','csv_path':str(p),'rows':len(df),'columns':list(map(str,df.columns))}\n    (out/'manifest.json').write_text(json.dumps(manifest,indent=2), encoding='utf-8'); return manifest\n\n# -----------------------------\n# 05 validation / readiness\n# -----------------------------\ndef validate_log_table(logs):\n    issues=[]\n    for c in REQUIRED_LOG_COLUMNS:\n        if c not in logs.columns: issues.append({'Severity':'error','Column':c,'Message':'Missing required log column.'})\n    for c in logs.columns:\n        fam=target_alias_lookup().get(normalize_header_name(c))\n        if fam: issues.append({'Severity':'error','Column':str(c),'Message':f'Target-only/calibration column in feature-side input: {fam[0]} matched {fam[1]}.'})\n    if logs.empty: issues.append({'Severity':'error','Column':'table','Message':'No rows loaded.'})\n    if 'well_alias' in logs and logs['well_alias'].isna().any(): issues.append({'Severity':'error','Column':'well_alias','Message':'Missing well aliases.'})\n    if {'well_alias','depth_m'} <= set(logs.columns):\n        for alias, grp in logs.groupby('well_alias', dropna=False):\n            d=clean_numeric_series(grp['depth_m'])\n            if not d.is_monotonic_increasing: issues.append({'Severity':'warning','Column':'depth_m','Message':f'Depth not monotonic for well {alias}.'})\n            if d.duplicated().any(): issues.append({'Severity':'warning','Column':'depth_m','Message':f'Duplicate depths for well {alias}.'})\n    if 'well_alias' in logs:\n        wc=int(logs['well_alias'].nunique())\n        if wc != EXPECTED_WELL_COUNT: issues.append({'Severity':'warning','Column':'well_alias','Message':f'Expected {EXPECTED_WELL_COUNT} wells; detected {wc}.'})\n    if not NORMALIZED_INPUTS:\n        for c,(lo,hi) in RANGE_CHECKS_PHYSICAL.items():\n            if c in logs:\n                v=clean_numeric_series(logs[c]);\n                if v.notna().any() and (~v.dropna().between(lo,hi)).any(): issues.append({'Severity':'warning','Column':c,'Message':f'Values outside expected range {lo} to {hi}.'})\n                if v.isna().mean()>0.25: issues.append({'Severity':'warning','Column':c,'Message':f'{v.isna().mean()*100:.1f}% missing.'})\n    else:\n        for c in logs.columns:\n            if c in IDENTIFIER_AND_CONTEXT_COLUMNS or target_like_column(c): continue\n            v=clean_numeric_series(logs[c])\n            if v.notna().any() and v.isna().mean()>0.25: issues.append({'Severity':'warning','Column':str(c),'Message':f'{v.isna().mean()*100:.1f}% missing in normalized input.'})\n    status='blocked' if any(i['Severity']=='error' for i in issues) else 'ready'\n    return status, pd.DataFrame(issues)\ndef curve_coverage_frame(logs):\n    rows=[]\n    for c in REQUIRED_LOG_COLUMNS+OPTIONAL_LOG_COLUMNS:\n        present=c in logs; cov=float(logs[c].notna().mean()*100) if present and len(logs) else 0.0\n        rows.append({'Canonical column':c,'Requirement':'Required' if c in REQUIRED_LOG_COLUMNS else 'Optional/routed','Present':'Yes' if present else 'No','Coverage %':round(cov,1)})\n    return pd.DataFrame(rows)\ndef dataset_inventory_frame(datasets):\n    rows=[]\n    for ds in datasets:\n        f=ds['frame']; depth=clean_numeric_series(f['depth_m']) if 'depth_m' in f else pd.Series(dtype=float)\n        rows.append({'source_dataset':ds['label'],'split':ds['split'],'file_name':Path(ds['path']).name,'sheet_name':ds['sheet_name'],'rows':len(f),'columns':len(f.columns),'wells':int(f['well_alias'].nunique()) if 'well_alias' in f else 0,'depth_min':float(depth.min()) if depth.notna().any() else None,'depth_max':float(depth.max()) if depth.notna().any() else None})\n    return pd.DataFrame(rows)\n\n# -----------------------------\n# 06 feature engineering / leakage policy\n# -----------------------------\ndef add_standard_features(logs):\n    f=logs.copy()\n    if 'gr_api' in f: f['vshale_proxy']=clean_numeric_series(f['gr_api']).clip(0,1) if NORMALIZED_INPUTS else ((clean_numeric_series(f['gr_api'])-30)/(105-30)).clip(0,1)\n    if 'rhob_g_cc' in f and 'density_porosity_vv' not in f:\n        r=clean_numeric_series(f['rhob_g_cc']); f['density_porosity_vv']=(1-r).clip(0,1) if NORMALIZED_INPUTS else ((2.65-r)/(2.65-1.03)).clip(0,0.7)\n    if not NORMALIZED_INPUTS:\n        if 'dt_us_ft' in f and 'vp_km_s' not in f: f['vp_km_s']=304.8/clean_numeric_series(f['dt_us_ft'])\n        if 'dts_us_ft' in f and 'vs_km_s' not in f: f['vs_km_s']=304.8/clean_numeric_series(f['dts_us_ft'])\n        if 'vp_m_s' in f and 'vp_km_s' not in f: f['vp_km_s']=clean_numeric_series(f['vp_m_s'])/1000.0\n        if 'vs_m_s' in f and 'vs_km_s' not in f: f['vs_km_s']=clean_numeric_series(f['vs_m_s'])/1000.0\n    if {'vp_km_s','vs_km_s'} <= set(f.columns): f['vp_vs_ratio']=clean_numeric_series(f['vp_km_s'])/clean_numeric_series(f['vs_km_s']).replace(0,np.nan)\n    if {'rhob_g_cc','vs_km_s'} <= set(f.columns): f['shear_modulus_proxy']=clean_numeric_series(f['rhob_g_cc'])*clean_numeric_series(f['vs_km_s'])**2\n    if {'rhob_g_cc','vp_km_s','vs_km_s'} <= set(f.columns): f['bulk_modulus_proxy']=clean_numeric_series(f['rhob_g_cc'])*(clean_numeric_series(f['vp_km_s'])**2-(4/3)*clean_numeric_series(f['vs_km_s'])**2)\n    # Project-specific: no real measured NMR required. Use proxies only.\n    if USE_REAL_NMR_IF_PRESENT and {'density_porosity_vv','nmr_porosity_vv'} <= set(f.columns):\n        f['nmr_density_separation_vv']=clean_numeric_series(f['density_porosity_vv'])-clean_numeric_series(f['nmr_porosity_vv'])\n        f['nmr_density_hydrate_proxy']=(f['nmr_density_separation_vv']/clean_numeric_series(f['density_porosity_vv']).clip(0.01)).clip(0,1)\n    else:\n        if {'density_porosity_vv','rt_ohm_m'} <= set(f.columns):\n            phi=clean_numeric_series(f['density_porosity_vv']).clip(0.01); rt=clean_numeric_series(f['rt_ohm_m']).clip(0.01)\n            f['log_proxy_hydrate_index']=(phi*rt).clip(0,1) if NORMALIZED_INPUTS else (1-((0.12/(phi.clip(0.04)**2*rt))**0.5)).clip(0,1)\n        if {'density_porosity_vv','vp_km_s'} <= set(f.columns): f['density_sonic_proxy_index']=(clean_numeric_series(f['density_porosity_vv'])*clean_numeric_series(f['vp_km_s'])).clip(0,1) if NORMALIZED_INPUTS else clean_numeric_series(f['density_porosity_vv'])*clean_numeric_series(f['vp_km_s'])\n        f['nmr_proxy_status']='proxy_only_no_real_nmr_required'\n    if 'caliper_in' in f:\n        cal=clean_numeric_series(f['caliper_in']); thr=cal.groupby(f['well_alias']).transform(lambda x:x.quantile(.95)) if 'well_alias' in f else pd.Series(cal.quantile(.95), index=f.index)\n        f['caliper_washout_flag']=cal.ge(thr)&cal.notna()\n    av=[c for c in CHONG_ML_FEATURE_COLUMNS if c in f.columns]\n    f['chong_ml_available_feature_count']=f[av].notna().sum(axis=1) if av else 0\n    f['chong_ml_complete_case_flag']=f[av].notna().all(axis=1) if av else False\n    if 'caliper_washout_flag' in f: f['chong_ml_complete_case_flag'] &= ~f['caliper_washout_flag']\n    return f.replace([np.inf,-np.inf],np.nan)\ndef make_feature_matrix(frame, target_columns):\n    features=add_standard_features(frame); selected=[]; inv=[]; audit=[]\n    for c in features.columns:\n        name=str(c); can=canonical_name_for_header(name); duplicate=can is not None and can!=name and can in features.columns\n        reason=''\n        if name in target_columns or target_like_column(name): reason='target_or_target_like_leakage'\n        elif name in IDENTIFIER_AND_CONTEXT_COLUMNS: reason='identifier_or_runtime_context'\n        elif is_context_or_helper_column(name): reason='context_depth_unit_or_spreadsheet_helper'\n        elif duplicate: reason=f'raw_alias_duplicate_of_{can}'\n        elif name=='nmr_porosity_vv' and not USE_REAL_NMR_IF_PRESENT: reason='real_nmr_disabled_for_current_project_state'\n        elif not pd.api.types.is_numeric_dtype(features[c]) and not pd.api.types.is_bool_dtype(features[c]): reason='non_numeric_or_categorical'\n        v=None\n        if not reason:\n            v=clean_numeric_series(features[c].astype(int) if pd.api.types.is_bool_dtype(features[c]) else features[c])\n            if v.notna().sum()==0: reason='numeric_empty_after_cleaning'\n        audit.append({'column':name,'decision':'excluded' if reason else 'included','reason':reason,'canonical_header':can or '','numeric_rows':int(v.notna().sum()) if v is not None else 0})\n        if reason: continue\n        features[name]=v; selected.append(name); inv.append({'feature_column':name,'non_null_rows':int(v.notna().sum()),'coverage_fraction':round(float(v.notna().mean()),4),'minimum':float(v.min()),'maximum':float(v.max()),'input_state':'already_normalized' if NORMALIZED_INPUTS else 'physical_or_mixed_units'})\n    X=clean_numeric_frame(features[selected].copy()) if selected else pd.DataFrame(index=features.index)\n    return X, pd.DataFrame(inv), pd.DataFrame(audit)\n\n# -----------------------------\n# 07 header scan / target detection\n# -----------------------------\ndef header_role_hint(c):\n    if target_like_column(c): return 'possible_target_review'\n    can=canonical_name_for_header(c)\n    if can in {'well_alias','depth_m'}: return 'identifier_or_depth_axis'\n    if can: return 'candidate_feature_or_context'\n    return 'unmapped_review'\ndef scan_three_dataset_headers(data_dir=DATA_DIR, files=WORKBOOKS, sample_rows=25, output_root=OUTPUT_ROOT, run_label=None):\n    label=sanitize_label(run_label or 'header_scan_'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')); out=Path(output_root)/label; out.mkdir(parents=True, exist_ok=True)\n    sheets=[]; cols=[]; missing=[]\n    for f in files:\n        p=Path(data_dir)/f\n        if not p.exists(): missing.append(str(p)); continue\n        with pd.ExcelFile(p) as xl: names=list(xl.sheet_names)\n        for s in names:\n            sample=pd.read_excel(p, sheet_name=s, nrows=sample_rows); head=pd.read_excel(p, sheet_name=s, nrows=0)\n            sheets.append({'workbook':f,'sheet_name':s,'sampled_rows':len(sample),'column_count':len(head.columns),'has_target_like_header':any(target_like_column(c) for c in head.columns)})\n            for i,c in enumerate(head.columns,1):\n                vals=sample[c] if c in sample else pd.Series(dtype=object); nums=clean_numeric_series(vals); role=header_role_hint(c)\n                task='classification' if role=='possible_target_review' and any(h in normalize_header_name(c) for h in CLASSIFICATION_NAME_HINTS) else ('regression' if saturation_like_column(c) else '')\n                cols.append({'workbook':f,'sheet_name':s,'column_position':i,'original_header':str(c),'normalized_header':normalize_header_name(c),'canonical_header':canonical_name_for_header(c) or '','role_hint':role,'non_null_sample_rows':int(vals.notna().sum()),'numeric_sample_rows':int(nums.notna().sum()),'unique_sample_values':int(vals.dropna().nunique()),'suggested_target_task':task})\n    sf=pd.DataFrame(sheets); cf=pd.DataFrame(cols); tf=cf[cf['role_hint'].str.contains('target',case=False,na=False)].copy() if not cf.empty else pd.DataFrame()\n    sf.to_csv(out/'workbook_sheet_inventory.csv',index=False); cf.to_csv(out/'workbook_column_inventory.csv',index=False); tf.to_csv(out/'target_header_hints.csv',index=False)\n    manifest={'generated_at_utc':datetime.now(timezone.utc).isoformat(timespec='seconds'),'missing_files':missing,'run_dir':str(out),'target_hint_count':int(len(tf)),'guardrail':'header scan only; no workbook rows committed'}\n    (out/'header_scan_manifest.json').write_text(json.dumps(manifest,indent=2), encoding='utf-8'); return manifest\ndef detect_target_candidates(frame):\n    rows=[]; look=target_alias_lookup()\n    for c in frame.columns:\n        n=normalize_header_name(c); fam=look.get(n,('',''))[0]\n        if fam or target_like_column(c):\n            vals=frame[c]; nums=clean_numeric_series(vals)\n            task='classification' if fam=='phase_or_occurrence_label' or any(h in n for h in CLASSIFICATION_NAME_HINTS) else ('regression' if nums.notna().sum()>0 else 'classification')\n            rows.append({'column':str(c),'normalized_column':n,'target_family':fam or 'target_like_unregistered','task_hint':task,'non_null_rows':int(vals.notna().sum()),'numeric_non_null_rows':int(nums.notna().sum()),'unique_non_null_values':int(vals.dropna().nunique())})\n    return pd.DataFrame(rows)\ndef find_column_by_request(frame, requested):\n    if requested in frame.columns: return requested\n    rn=normalize_header_name(requested)\n    for c in frame.columns:\n        if normalize_header_name(c)==rn: return str(c)\n    return None\ndef infer_task_for_column(frame, col, requested='auto'):\n    if requested!='auto': return requested\n    n=normalize_header_name(col)\n    if any(h in n for h in CLASSIFICATION_NAME_HINTS): return 'classification'\n    if any(h in n for h in REGRESSION_NAME_HINTS): return 'regression'\n    nums=clean_numeric_series(frame[col]); return 'regression' if nums.notna().sum() >= max(3, int(frame[col].notna().sum()*0.8)) else 'classification'\ndef choose_target(train_frame, requested_target='auto', requested_task='auto'):\n    cands=detect_target_candidates(train_frame); selected=None; reason=''\n    if requested_target!='auto':\n        selected=find_column_by_request(train_frame, requested_target)\n        if selected is None: raise ValueError(f'Requested target {requested_target!r} not found')\n        reason='target requested by notebook variable'\n    elif not cands.empty:\n        order=cands.copy(); order['priority']=order['target_family'].map({'hydrate_saturation':0,'phase_or_occurrence_label':1,'target_like_unregistered':2,'irreducible_or_residual_water_saturation':3}).fillna(9)\n        order=order.sort_values(['priority','non_null_rows','unique_non_null_values'], ascending=[True,False,False]); selected=str(order.iloc[0]['column']); reason='first usable target-like column by project priority'\n    if selected is None: return {'column':None,'task':'readiness_only','family':'none_detected','reason':'no target-like column detected'}, cands\n    task=infer_task_for_column(train_frame, selected, requested_task); fam=target_alias_lookup().get(normalize_header_name(selected),('target_like_unregistered',''))[0]\n    if not cands.empty: cands['selected']=cands['column'].astype(str).eq(selected)\n    return {'column':selected,'task':task,'family':fam,'reason':reason}, cands\n\n# -----------------------------\n# 08 modeling / main pipeline\n# -----------------------------\ndef build_model_pipeline(task, model_kind=DEFAULT_MODEL_KIND, random_state=RANDOM_STATE):\n    if model_kind=='mlp': model=MLPClassifier(hidden_layer_sizes=(32,16),max_iter=600,random_state=random_state) if task=='classification' else MLPRegressor(hidden_layer_sizes=(32,16),max_iter=600,random_state=random_state)\n    else: model=RandomForestClassifier(n_estimators=250,min_samples_leaf=2,class_weight='balanced',random_state=random_state) if task=='classification' else RandomForestRegressor(n_estimators=250,min_samples_leaf=2,random_state=random_state)\n    steps=[('imputer',SimpleImputer(strategy='median'))]\n    if USE_SCALER or model_kind=='mlp': steps.append(('minmax_scaler',MinMaxScaler()))\n    steps.append(('model',model)); return Pipeline(steps)\ndef evaluate_predictions(y_true, y_pred, task):\n    if task=='classification': return {'rows_scored':int(len(y_true)),'accuracy':float(accuracy_score(y_true,y_pred)),'balanced_accuracy':float(balanced_accuracy_score(y_true,y_pred)),'f1_macro':float(f1_score(y_true,y_pred,average='macro',zero_division=0))}\n    yt=clean_numeric_series(y_true); yp=clean_numeric_series(pd.Series(y_pred)); return {'rows_scored':int(len(yt)),'mae':float(mean_absolute_error(yt,yp)),'rmse':float(np.sqrt(mean_squared_error(yt,yp))),'r2':float(r2_score(yt,yp)) if len(yt)>=2 else None}\ndef prepare_supervised_table(frame, target, feature_columns, target_columns):\n    Xall,_,_=make_feature_matrix(frame, target_columns)\n    for c in feature_columns:\n        if c not in Xall: Xall[c]=np.nan\n    X=clean_numeric_frame(Xall[feature_columns].copy()); y=clean_numeric_series(frame[target['column']]) if target['task']=='regression' else frame[target['column']].astype('string')\n    m=y.notna() & X.notna().any(axis=1); return X.loc[m].reset_index(drop=True), y.loc[m].reset_index(drop=True), frame.loc[m].reset_index(drop=True)\ndef prepare_feature_only_table(frame, feature_columns, target_columns):\n    Xall,_,_=make_feature_matrix(frame, target_columns)\n    for c in feature_columns:\n        if c not in Xall: Xall[c]=np.nan\n    X=clean_numeric_frame(Xall[feature_columns].copy()); m=X.notna().any(axis=1); return X.loc[m].reset_index(drop=True), frame.loc[m].reset_index(drop=True)\ndef prediction_frame(src, y_true, y_pred, target_col, task, model=None, X=None):\n    out=pd.DataFrame({'source_dataset':src.get('source_dataset',pd.Series(['']*len(src))).astype(str),'dataset_file':src.get('dataset_file',pd.Series(['']*len(src))).astype(str),'well_alias':src.get('well_alias',pd.Series(['']*len(src))).astype(str),'row_index':src.get('row_index',pd.Series(range(len(src)))),'target_column':target_col,'y_pred':y_pred})\n    if 'depth_m' in src: out['depth_m']=src['depth_m']\n    if y_true is not None: out['y_true']=y_true.to_numpy()\n    if task=='classification' and model is not None and hasattr(model,'predict_proba') and X is not None:\n        try: out['y_pred_probability_max']=model.predict_proba(X).max(axis=1)\n        except Exception: pass\n    return out\ndef run_three_dataset_pipeline(data_dir=DATA_DIR, train_file='curated_dataset1.xlsx', test_files=('curated_dataset2.xlsx','curated_dataset3.xlsx'), sheet_name=None, requested_target='auto', requested_task='auto', model_kind=DEFAULT_MODEL_KIND, run_label=None):\n    label=sanitize_label(run_label or 'three_dataset_ml_run_'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')); out=OUTPUT_ROOT/label; mod=MODEL_ROOT/label; out.mkdir(parents=True, exist_ok=True); mod.mkdir(parents=True, exist_ok=True)\n    datasets=load_three_dataset_workbooks(data_dir, train_file, test_files, sheet_name); train=datasets[0]; target,cands=choose_target(train['frame'], requested_target, requested_task)\n    target_cols=set(cands.get('column', pd.Series(dtype=str)).astype(str)) if not cands.empty else set();\n    if target['column']: target_cols.add(target['column'])\n    dataset_inventory_frame(datasets).to_csv(out/'dataset_inventory.csv',index=False); cands.to_csv(out/'target_detection.csv',index=False)\n    readiness=[]\n    for ds in datasets:\n        status, issues=validate_log_table(ds['frame'].drop(columns=list(target_cols), errors='ignore')); issues.insert(0,'source_dataset',ds['label']); issues.insert(1,'split',ds['split']); issues.insert(2,'status',status); readiness.append(issues)\n        curve_coverage_frame(ds['frame']).to_csv(out/f'curve_coverage_{sanitize_label(ds["label"])}.csv',index=False)\n    (pd.concat(readiness,ignore_index=True) if readiness else pd.DataFrame()).to_csv(out/'schema_readiness.csv',index=False)\n    X0, finv, audit=make_feature_matrix(train['frame'], target_cols); finv.to_csv(out/'feature_columns.csv',index=False); audit.to_csv(out/'feature_policy_audit.csv',index=False)\n    feature_columns=list(X0.columns); train_metrics=[]; test_metrics=[]; written={'dataset_inventory':str(out/'dataset_inventory.csv'),'schema_readiness':str(out/'schema_readiness.csv'),'target_detection':str(out/'target_detection.csv'),'feature_columns':str(out/'feature_columns.csv'),'feature_policy_audit':str(out/'feature_policy_audit.csv')}\n    status='readiness_only'; blocked=''\n    if target['column'] is None: blocked=target['reason']\n    elif not feature_columns: blocked='no numeric non-target feature columns detected after leakage/context exclusions'\n    else:\n        Xtr,ytr,rows=prepare_supervised_table(train['frame'], target, feature_columns, target_cols)\n        if len(Xtr)<3: blocked='fewer than three target-bearing training rows after preprocessing'\n        elif target['task']=='classification' and ytr.nunique()<2: blocked='classification target has fewer than two classes'\n        else:\n            model=build_model_pipeline(target['task'], model_kind); model.fit(Xtr,ytr); pred=model.predict(Xtr)\n            m=evaluate_predictions(ytr,pred,target['task']); m.update({'dataset':train['label'],'split':'train','task':target['task'],'target_column':target['column'],'model_kind':model_kind,'feature_count':len(feature_columns)}); train_metrics.append(m)\n            p=out/f'predictions_{sanitize_label(train["label"])}.csv'; prediction_frame(rows,ytr,pred,target['column'],target['task'],model,Xtr).to_csv(p,index=False); written['train_predictions']=str(p)\n            for ds in datasets[1:]:\n                if target['column'] in ds['frame'].columns:\n                    Xt,yt,trows=prepare_supervised_table(ds['frame'],target,feature_columns,target_cols); ytrue=yt\n                else:\n                    Xt,trows=prepare_feature_only_table(ds['frame'],feature_columns,target_cols); ytrue=None\n                if Xt.empty:\n                    test_metrics.append({'dataset':ds['label'],'split':'test','status':'blocked','blocked_reason':'no feature rows available','rows_scored':0}); continue\n                tp=model.predict(Xt); pp=out/f'predictions_{sanitize_label(ds["label"])}.csv'; prediction_frame(trows,ytrue,tp,target['column'],target['task'],model,Xt).to_csv(pp,index=False); written[f'predictions_{ds["label"]}']=str(pp)\n                if ytrue is not None and len(ytrue)>0:\n                    mm=evaluate_predictions(ytrue,tp,target['task']); mm.update({'dataset':ds['label'],'split':'test','status':'scored','task':target['task'],'target_column':target['column'],'feature_count':len(feature_columns)}); test_metrics.append(mm)\n                else: test_metrics.append({'dataset':ds['label'],'split':'test','status':'predicted_unlabeled','rows_scored':int(len(Xt)),'target_column':target['column'],'feature_count':len(feature_columns)})\n            dump({'model':model,'feature_columns':feature_columns,'target':target,'model_kind':model_kind,'normalized_inputs':NORMALIZED_INPUTS,'real_nmr_used':USE_REAL_NMR_IF_PRESENT}, mod/'model.joblib'); written['model']=str(mod/'model.joblib'); status='trained'\n    pd.DataFrame(train_metrics).to_csv(out/'train_metrics.csv',index=False); pd.DataFrame(test_metrics).to_csv(out/'test_metrics.csv',index=False); written['train_metrics']=str(out/'train_metrics.csv'); written['test_metrics']=str(out/'test_metrics.csv')\n    manifest={'generated_at_utc':datetime.now(timezone.utc).isoformat(timespec='seconds'),'status':status,'blocked_reason':blocked,'data_dir_name':Path(data_dir).name,'train_file':train_file,'test_files':list(test_files),'target':target,'model_kind':model_kind,'feature_count':len(feature_columns),'feature_columns':feature_columns,'outputs':written,'assumptions':{'expected_well_count':EXPECTED_WELL_COUNT,'normalized_inputs':NORMALIZED_INPUTS,'real_nmr_required':False},'guardrail':'approved rows/predictions/models stay local'}\n    (out/'run_manifest.json').write_text(json.dumps(manifest,indent=2,default=str), encoding='utf-8'); return {'status':status,'blocked_reason':blocked,'run_dir':str(out),'model_dir':str(mod),'target':target,'feature_count':len(feature_columns),'outputs':written}\n\n# -----------------------------\n# 09 all saturation targets\n# -----------------------------\ndef read_workbook_sheets(data_dir=DATA_DIR, workbook_names=WORKBOOKS):\n    sheets=[]\n    for wb in workbook_names:\n        p=Path(data_dir)/wb\n        if not p.exists(): continue\n        with pd.ExcelFile(p) as xl: names=list(xl.sheet_names)\n        for s in names:\n            df=standardize_curve_columns(pd.read_excel(p, sheet_name=s)); df['source_workbook']=wb; df['source_sheet_name']=str(s); df['row_index']=np.arange(len(df))\n            if 'well_alias' not in df: df['well_alias']=Path(wb).stem\n            sheets.append({'workbook':wb,'sheet':str(s),'frame':df})\n    return sheets\ndef saturation_target_inventory(sheets):\n    rows=[]\n    for sh in sheets:\n        df=sh['frame']\n        for c in df.columns:\n            if saturation_like_column(c):\n                v=clean_numeric_series(df[c]); rows.append({'workbook':sh['workbook'],'sheet_name':sh['sheet'],'target_column':str(c),'numeric_rows':int(v.notna().sum()),'unique_values':int(v.dropna().nunique()),'minimum':float(v.min()) if v.notna().any() else None,'maximum':float(v.max()) if v.notna().any() else None})\n    return pd.DataFrame(rows)\ndef find_feature_source_for_target(target_sheet, target_col, sheets):\n    tf=target_sheet['frame']; sat={str(c) for c in tf.columns if saturation_like_column(c)}; X,_,_=make_feature_matrix(tf,sat)\n    if not X.empty: return tf.copy(), target_sheet['workbook'], 'same_sheet'\n    scored=[]\n    for cand in sheets:\n        cf=cand['frame']; csat={str(c) for c in cf.columns if saturation_like_column(c)}; Xc,_,_=make_feature_matrix(cf,csat)\n        if Xc.empty: continue\n        score=len(Xc.columns)+(100 if len(cf)==len(tf) else 0)+(50 if cand['sheet']==target_sheet['sheet'] else 0)\n        scored.append((score,cand))\n    if not scored: return None,'','blocked_no_feature_source'\n    best=sorted(scored,key=lambda x:x[0],reverse=True)[0][1]\n    if len(best['frame'])!=len(tf): return None,best['workbook'],'blocked_row_count_mismatch'\n    aligned=best['frame'].reset_index(drop=True).copy(); aligned[target_col]=tf[target_col].reset_index(drop=True); return aligned,best['workbook'],'row_order_aligned'\ndef fit_and_predict_all_saturations(data_dir=DATA_DIR, workbook_names=WORKBOOKS, output_dir=None, min_training_rows=5):\n    output_dir=Path(output_dir) if output_dir else OUTPUT_ROOT/('multi_saturation_'+datetime.now().strftime('%Y%m%d_%H%M%S')); output_dir.mkdir(parents=True, exist_ok=True)\n    sheets=read_workbook_sheets(data_dir, workbook_names); inv=saturation_target_inventory(sheets); inv.to_csv(output_dir/'saturation_target_inventory.csv',index=False)\n    pd.DataFrame([{'workbook':s['workbook'],'sheet_name':s['sheet'],'rows':len(s['frame']),'columns':len(s['frame'].columns)} for s in sheets]).to_csv(output_dir/'sheet_inventory.csv',index=False)\n    if inv.empty:\n        (output_dir/'run_summary.csv').write_text('status,message\\nblocked,no saturation targets found\\n', encoding='utf-8'); return {'status':'blocked','message':'no saturation targets found','output_dir':str(output_dir)}\n    summary=[]; feature_rows=[]; audit_frames=[]\n    for _,t in inv.iterrows():\n        target_sheet=next(s for s in sheets if s['workbook']==t['workbook'] and s['sheet']==t['sheet_name']); col=str(t['target_column']); tid=sanitize_label(f'{t["workbook"]}_{t["sheet_name"]}_{col}')\n        train_frame, feature_source, align = find_feature_source_for_target(target_sheet,col,sheets)\n        if train_frame is None:\n            summary.append({'target_id':tid,'target_column':col,'target_workbook':t['workbook'],'target_sheet':t['sheet_name'],'status':'blocked','alignment_method':align,'feature_source':feature_source,'training_rows':0}); continue\n        sat={str(c) for c in train_frame.columns if saturation_like_column(c)}; Xall,finv,audit=make_feature_matrix(train_frame,sat); audit['target_id']=tid; audit_frames.append(audit); y=clean_numeric_series(train_frame[col]); mask=y.notna() & Xall.notna().any(axis=1); Xtr=Xall.loc[mask].reset_index(drop=True); ytr=y.loc[mask].reset_index(drop=True)\n        if len(Xtr)<min_training_rows:\n            summary.append({'target_id':tid,'target_column':col,'target_workbook':t['workbook'],'target_sheet':t['sheet_name'],'status':'blocked','alignment_method':align,'feature_source':feature_source,'training_rows':len(Xtr),'blocked_reason':'not enough target-bearing training rows'}); continue\n        features=list(Xtr.columns); model=Pipeline([('imputer',SimpleImputer(strategy='median')),('model',RandomForestRegressor(n_estimators=250,min_samples_leaf=2,random_state=42))]); model.fit(Xtr[features],ytr); pred=model.predict(Xtr[features]); tdir=output_dir/tid; tdir.mkdir(exist_ok=True)\n        for f in features: feature_rows.append({'target_id':tid,'feature_column':f})\n        metric_rows=[]; pred_files=[]\n        for sh in sheets:\n            fr=sh['frame']; sat2={str(c) for c in fr.columns if saturation_like_column(c)}; Xp,_,_=make_feature_matrix(fr,sat2)\n            for f in features:\n                if f not in Xp: Xp[f]=np.nan\n            Xp=clean_numeric_frame(Xp[features]); m=Xp.notna().any(axis=1)\n            if not m.any(): continue\n            Xp2=Xp.loc[m].reset_index(drop=True); src=fr.loc[m].reset_index(drop=True); yp=model.predict(Xp2)\n            pf=pd.DataFrame({'target_id':tid,'target_column':col,'source_workbook':sh['workbook'],'source_sheet':sh['sheet'],'row_index':src.get('row_index',pd.Series(range(len(src)))),'y_pred':yp,'prediction_status':'scored_unlabeled'})\n            if 'well_alias' in src: pf['well_alias']=src['well_alias']\n            if 'depth_m' in src: pf['depth_m']=src['depth_m']\n            if col in src:\n                yt=clean_numeric_series(src[col]); valid=yt.notna(); pf.loc[valid,'y_true']=yt.loc[valid]; pf.loc[valid,'prediction_status']='scored_with_target'\n                if valid.sum()>=2: metric_rows.append({'target_id':tid,'source_workbook':sh['workbook'],'source_sheet':sh['sheet'],'rows_scored':int(valid.sum()),'mae':float(mean_absolute_error(yt.loc[valid], yp[valid])),'rmse':float(np.sqrt(mean_squared_error(yt.loc[valid], yp[valid]))),'r2':float(r2_score(yt.loc[valid], yp[valid]))})\n            pp=tdir/f'predictions_{sanitize_label(sh["workbook"])}_{sanitize_label(sh["sheet"])}.csv'; pf.to_csv(pp,index=False); pred_files.append(str(pp))\n        pd.DataFrame(metric_rows).to_csv(tdir/'metrics_by_sheet.csv',index=False)\n        summary.append({'target_id':tid,'target_column':col,'target_workbook':t['workbook'],'target_sheet':t['sheet_name'],'status':'trained','alignment_method':align,'feature_source':feature_source,'training_rows':int(len(Xtr)),'feature_count':len(features),'train_mae':float(mean_absolute_error(ytr,pred)),'train_rmse':float(np.sqrt(mean_squared_error(ytr,pred))),'train_r2':float(r2_score(ytr,pred)) if len(ytr)>=2 else None,'prediction_file_count':len(pred_files)})\n    rs=pd.DataFrame(summary); rs.to_csv(output_dir/'run_summary.csv',index=False); pd.DataFrame(feature_rows).to_csv(output_dir/'feature_columns_by_target.csv',index=False)\n    if audit_frames: pd.concat(audit_frames,ignore_index=True).to_csv(output_dir/'excluded_feature_columns_by_target.csv',index=False)\n    manifest={'status':'complete','output_dir':str(output_dir),'target_count':int(len(inv)),'trained_target_count':int((rs['status']=='trained').sum()) if not rs.empty else 0,'guardrail':'all saturation-like columns treated as target-only Y variables'}\n    (output_dir/'run_manifest.json').write_text(json.dumps(manifest,indent=2), encoding='utf-8'); return manifest\nprint('Integrated pipeline functions loaded.')"
